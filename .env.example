# Public site config
PUBLIC_SITE_URL=https://uboss.ai
PUBLIC_CONTACT_EMAIL=support@uboss.ai
PUBLIC_CAL_DISCOVERY=robg-uboss/discovery-call
PUBLIC_CAL_STRATEGY=robg-uboss/uboss-strategy

# Contact form delivery. Server-side only — never expose as PUBLIC_*, or the endpoint
# becomes a spam target. Set on Vercel per environment: the production webhook goes on
# the Production environment, the test webhook goes on Preview + Development.
N8N_CONTACT_WEBHOOK_URL=https://your-n8n-host/webhook/uboss-contact

# Cloudflare Turnstile (bot detection on the contact form, paired with the honeypot
# field). Create a free widget at the Cloudflare dashboard -> Turnstile, registering
# www.uboss.ai (and localhost, for local dev) as allowed hostnames.
# Site key ships to the browser — not a secret. Secret key verifies tokens server-side
# and must never be exposed as PUBLIC_*.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Future integrations (do not implement yet)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# WHATSAPP_WEBHOOK_URL=https://...
